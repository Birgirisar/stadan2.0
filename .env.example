# Copy to .env.local and fill in. Never commit real values.

# Client-side: bundled into the app (EXPO_PUBLIC_ prefix), so treat as public.
EXPO_PUBLIC_SPORTMONKS_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only: Supabase CLI / edge functions. Never use the EXPO_PUBLIC_ prefix for these.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SPORTMONKS_API_KEY=
ADMIN_TOKEN=
