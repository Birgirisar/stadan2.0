{
  "expo": {
    "name": "Staðan",
    "slug": "stadan",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stadan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "is.stadan.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "is.stadan.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0c0f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-font",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15df6b34-07ef-43ea-b176-cfb39d27d091"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/15df6b34-07ef-43ea-b176-cfb39d27d091"
    }
  }
